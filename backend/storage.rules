rules_version = '2';

// Ningún cliente accede directo a Storage: nuestra autenticación es el JWT
// propio del backend (no Firebase Auth), así que request.auth siempre es null.
// - Las subidas las hace el backend con firebase-admin, que ignora estas reglas
//   (y antes valida rol/permiso con RB-04).
// - Las lecturas se hacen con la URL que devuelve el backend, que incluye un
//   "download token": las URLs con token válido tampoco pasan por estas reglas.
// Por eso se puede cerrar todo sin romper nada (y nadie puede leer/pisar
// firmas usando solo la config del proyecto).
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
