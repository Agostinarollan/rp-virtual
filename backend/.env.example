# Base de datos MySQL (reemplazar usuario y contraseña por los de tu MySQL local)
DATABASE_URL="mysql://usuario:contrasena@localhost:3306/rp_virtual"

# Puerto de la API
PORT=3000

# JWT
JWT_SECRET="cambiar-este-secreto-en-produccion"
JWT_EXPIRES_IN="8h"

# Firebase - el prefijo "demo-" indica que es un proyecto solo para emuladores
# (nunca toca recursos reales y no hace falta "firebase login").
FIREBASE_PROJECT_ID="demo-rp-virtual"
FIREBASE_STORAGE_BUCKET="demo-rp-virtual.appspot.com"

# Emuladores locales: si estas variables están seteadas, firebase-admin
# redirige solo las llamadas de Storage y Firestore hacia el emulador.
# En producción se borran (o se comentan).
FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"
FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Solo en producción (Firebase real): ruta al JSON de la cuenta de servicio.
# GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"
