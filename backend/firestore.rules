rules_version = '2';

// Mismo criterio que storage.rules: el único que habla con Firestore es el
// backend (firebase-admin ignora estas reglas), y el control de permisos lo
// hace NestJS con el JWT (RB-04). Cualquier acceso directo desde un cliente
// (navegador, Postman con el SDK web, etc.) queda bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
